          "name": "运行规则",
          "value": "雾港没有太阳，人们使用记忆灯照明。",
          "basis": "explicit",
          "evidence": [
            {
              "unitId": "unit-4",
              "quote": "雾港没有太阳，每户依靠记忆灯照明。"
            }
          ]
        },
        {
          "name": "能力限制",
          "value": "灯只能消耗主人自愿交出的记忆，无法夺取他人记忆。",
          "basis": "explicit",
          "evidence": [
            {
              "unitId": "unit-4",
              "quote": "灯只燃烧主人自愿交出的记忆，不能取走他人的记忆。"
            }
          ]
        }
      ]
    },
